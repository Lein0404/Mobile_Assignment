<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer clock circle -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:pathData="M12,2a10,10 0 1,0 0,20a10,10 0 1,0 0,-20z" />

    <!-- Hour hand (shorter, pointing at 3) -->
    <path
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="2.5"
        android:pathData="M12,12h4" />

    <!-- Minute hand (longer, pointing at 12) -->
    <path
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="2.5"
        android:pathData="M12,12V6" />

    <!-- Center circle (joint) -->
    <path
        android:fillColor="#000000"
        android:pathData="M12,11a1,1 0 1,0 0,2a1,1 0 1,0 0,-2z" />

</vector>
